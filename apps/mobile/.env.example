# Copy to .env and fill in. Public values only: never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: Sentry is enabled only when set.
EXPO_PUBLIC_SENTRY_DSN=
# Optional: web app origin whose /v/<token> QR links the scanner accepts locally (default http://localhost:5173).
EXPO_PUBLIC_APP_URL=
