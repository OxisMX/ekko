# Copy to .env.local and fill in. Public values only: never the service_role key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Origin encoded in the visit QR (<origin>/v/<token>), no trailing slash. Staging: https://staging.ekko.oxis.mx; production: https://ekko.oxis.mx
VITE_PUBLIC_APP_URL=http://localhost:5173
# Optional: Sentry is enabled only when set.
VITE_SENTRY_DSN=
