# Local: supabase functions serve --env-file supabase/functions/.env
# Production: supabase secrets set --env-file ...  (SUPABASE_* are provided by the platform)
PANEL_ORIGINS=http://localhost:5173
EXPO_ACCESS_TOKEN=
# delete-account: browser origins allowed to call it (the native app sends no Origin; empty = browsers denied)
APP_ORIGINS=
# delete-account: Sign in with Apple revocation (SP-3). Required only for Apple accounts; without them those
# deletions fail closed with E-99. APPLE_PRIVATE_KEY is the .p8 contents (\n escapes allowed).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=
